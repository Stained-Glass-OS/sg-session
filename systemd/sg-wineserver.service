[Unit]
Description=Stained Glass machine-level wineserver (the Windows system)
Documentation=https://github.com/Stained-Glass-OS/stained-glass
# This is the machine's Windows side. It must exist before any login session,
# and outlive every logout -- a wineserver started by a session cannot host a
# service that runs from boot. See debt item D5.
After=sg-prefix-init.service systemd-tmpfiles-setup.service
Requires=sg-prefix-init.service
Before=greetd.service
ConditionPathExists=/var/lib/stained-glass/prefix/.sg-initialized

[Service]
Type=exec
# Runs as sgsystem, which owns the prefix and which wine-sg therefore maps to
# the SYSTEM SID. Unprivileged on the Unix side, on purpose: nothing about
# hosting the Windows system needs root. Device access for driver work comes
# from sgsystem's membership of lp, scanner, plugdev and friends, and the
# privilege to *install* a driver is NT administrator, which wine-sg decides
# from prefix ownership rather than from the kernel.
#
# Running this as root would put a root process on a socket every desktop user
# can reach and buy no capability an ordinary account lacks.
User=sgsystem
Group=sgwine
Environment=HOME=/var/lib/stained-glass
Environment=XDG_RUNTIME_DIR=/run/stained-glass
RuntimeDirectory=stained-glass
ExecStart=/usr/bin/sg-wineserver
# SYSTEM may change the permissions of a file another account owns, as on
# Windows (an elevated installer moving a download from the user's Temp into
# the machine's folders, then resetting its DACL). wine-sg 0466 keeps
# CAP_FOWNER permitted only -- it clears the ambient and effective sets at
# start -- and raises it for that one fchmod. And SYSTEM's own processes may
# be traced (wine-sg 0624): an elevated program has SYSTEM's group, the server
# the prefix's, and the kernel let the server read or write the memory only of
# processes whose groups match its own -- debuggers, ReadProcessMemory and
# MediaMonkey's setup failed. CAP_SYS_PTRACE is likewise permitted only and
# raised for one attach, only for a process of SYSTEM's. Nothing else of root's.
AmbientCapabilities=CAP_FOWNER CAP_SYS_PTRACE
# The prefix must be initialized before there is anything to serve, but a
# oneshot that has not finished holds this unit off entirely -- and a machine
# with no Windows system is worse than one that waits a little longer for it.

# The SCM is started once the server is up, not by the server itself: services
# belong to the Windows system, not to the process that happens to host it.
# ...and the Windows programs it starts do not inherit the capability.
ExecStartPost=/usr/bin/setpriv --ambient-caps -fowner --inh-caps -fowner /usr/bin/sg-services-start
# sg-services-start (registry protection, machine policy, the SCM) takes a
# minute or two on a slow or emulated machine; the default 90 s start timeout
# killed the whole server there -- and the lock screen with it. Its own waits
# are bounded well inside this.
TimeoutStartSec=5min
# Stopping it is ending the Windows system: every Windows process ends and the
# registry is written out, as wineserver -k does. Left to SIGTERM alone, the
# USB driver host (winedevice with libusb) outlived the server and held
# shutdown for the whole 90 s default before its SIGKILL.
ExecStop=/bin/sh -c '. /usr/lib/stained-glass/sg-common.sh; sg_wine_env; timeout 20 wineserver -k'
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
