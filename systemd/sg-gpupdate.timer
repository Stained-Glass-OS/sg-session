# Windows refreshes Group Policy every 90 minutes, with a random offset of up
# to 30 so a fleet does not arrive at once; and once soon after boot.
[Unit]
Description=Stained Glass machine Group Policy refresh

[Timer]
OnBootSec=2min
OnUnitActiveSec=90min
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
