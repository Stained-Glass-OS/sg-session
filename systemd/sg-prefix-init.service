[Unit]
Description=Initialize the Stained Glass system Wine prefix
Documentation=https://github.com/Stained-Glass-OS/stained-glass
# The prefix is built on first boot rather than baked into the image: the image
# build runs in a sandbox where /var is not the image's /var, so anything
# written there at build time is liable to be thrown away.
# It must exist before greetd starts a session against it.
Before=greetd.service
After=local-fs.target systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service
# Runs every boot, not only the first: sg-prefix-init builds the prefix when it
# is missing and otherwise brings it up to date -- a Wine upgrade's prefix
# update and newly packaged applications (run_installers) happen here, at boot,
# as the SYSTEM account, rather than inside the first user's session. It used to
# be conditioned on the stamp, so that path never ran after the first boot.

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as the SYSTEM account so the prefix is owned by it -- wine-sg reads
# ownership as "who administers this machine's Windows side".
User=sgsystem
Group=sgwine
Environment=HOME=/var/lib/stained-glass

# Wine wants an XDG_RUNTIME_DIR. There is no logind session here -- this runs
# before anyone logs in -- so systemd makes one for us and we point Wine at it.
# Without this, wineboot prints "XDG_RUNTIME_DIR is invalid or not set" and
# parts of the prefix build misbehave.
RuntimeDirectory=stained-glass
Environment=XDG_RUNTIME_DIR=/run/stained-glass

ExecStart=/usr/bin/sg-prefix-init
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
