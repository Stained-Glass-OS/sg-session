[Unit]
Description=Initialize the Stained Glass system Wine prefix
Documentation=https://github.com/Stained-Glass-OS/stained-glass
# The prefix is normally baked into the image. This unit is the first-boot
# fallback, so it must finish before anything tries to use the prefix.
Before=greetd.service
After=local-fs.target
ConditionPathExists=!/var/lib/stained-glass/prefix/.sg-initialized

[Service]
Type=oneshot
RemainAfterExit=yes
User=sguser
Group=sguser
Environment=HOME=/var/lib/stained-glass
ExecStart=/usr/bin/sg-prefix-init
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
