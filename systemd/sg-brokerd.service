[Unit]
Description=Stained Glass OS elevation broker (Run as administrator)
Documentation=https://github.com/Stained-Glass-OS/stained-glass
# The broker starts programs as the SYSTEM account after consent on the secure
# surface. It needs the compositor's seat for that surface, and the prefix.
# The consent prompt is a Windows program run in the machine-level wineserver.
After=sg-prefix-init.service sg-wineserver.service
Wants=sg-prefix-init.service sg-wineserver.service

[Service]
Type=simple
Environment=SG_BROKER_FOREGROUND=1
Environment=SG_BROKERD_LOG=/var/log/stained-glass/brokerd.log
Environment=SG_LOG_DIR=/var/log/stained-glass
Environment=SG_SEAT_DIR=/run/stained-glass-seat/seat0
# Root: it authenticates administrators through PAM and launches the elevated
# program as the SYSTEM account. Like sg-lockd, it forks a small root monitor
# for PAM and the main process drops to the SYSTEM account itself.
RuntimeDirectory=stained-glass-broker
RuntimeDirectoryMode=0755
ExecStart=/usr/libexec/stained-glass/sg-brokerd
Restart=on-failure

[Install]
WantedBy=multi-user.target
