#!/bin/sh
# The Phase 0 gate, guest side.
#
# Answers one question with an exit code: is a Windows shell actually running
# on this machine, and can it launch and show a Win32 app? Printed output is
# for a human reading CI logs; the exit code is what the gate consumes.
#
#   0  all checks passed
#   1  a check failed
#   2  the session never came up (nothing to check)
set -u

SG_LIB="${SG_LIB:-/usr/lib/stained-glass}"
# shellcheck source=lib/sg-common.sh
. "$SG_LIB/sg-common.sh"

TIMEOUT="${SG_CHECK_TIMEOUT:-120}"
FAILED=0

pass() { echo "PASS  $*"; }
fail() { echo "FAIL  $*"; FAILED=1; }
info() { echo "info  $*"; }

# --- wait for the session to publish itself -------------------------------
waited=0
while [ ! -f "$SG_STATE/session.env" ]; do
    [ "$waited" -ge "$TIMEOUT" ] && { echo "FAIL  session never started (no $SG_STATE/session.env after ${TIMEOUT}s)"; exit 2; }
    sleep 2
    waited=$((waited + 2))
done
# shellcheck source=/dev/null  # written by sg-run-explorer at session start
. "$SG_STATE/session.env"
export DISPLAY XDG_RUNTIME_DIR WAYLAND_DISPLAY WINEPREFIX
info "session.env found after ${waited}s (display=${DISPLAY:-none} path=${SG_DISPLAY_PATH:-?})"

sg_wine_env

# --- 1. the Wine system is alive ------------------------------------------
# wineserver is the kernel of the Wine personality. If it is not running,
# nothing else below means anything.
waited=0
while ! pgrep -x wineserver >/dev/null 2>&1 && ! pgrep -f 'wineserver' >/dev/null 2>&1; do
    [ "$waited" -ge "$TIMEOUT" ] && break
    sleep 2
    waited=$((waited + 2))
done
if pgrep -f wineserver >/dev/null 2>&1; then
    pass "wineserver is running"
else
    fail "wineserver is not running"
fi

# explorer must be the one we asked for: the virtual-desktop shell, not the
# bare autostart instance wineboot leaves behind.
waited=0
while ! pgrep -f 'explorer.exe .*/desktop=shell' >/dev/null 2>&1; do
    [ "$waited" -ge "$TIMEOUT" ] && break
    sleep 2
    waited=$((waited + 2))
done
if pgrep -f 'explorer.exe .*/desktop=shell' >/dev/null 2>&1; then
    pass "explorer.exe is running as the shell desktop"
else
    fail "explorer.exe is not running as the shell desktop"
fi

# --- 2. the desktop window exists -----------------------------------------
# Only the X11 path can be checked this way. cage exposes no toplevel
# enumeration protocol, so on the Wayland path there is nothing to query --
# which is itself the reason Phase 0 ships the X11 path (ADR 0003).
if [ "${SG_DISPLAY_PATH:-x11}" != "x11" ]; then
    fail "display path is '${SG_DISPLAY_PATH}': window checks are only implemented for x11"
    echo; echo "RESULT: $([ "$FAILED" -eq 0 ] && echo PASS || echo FAIL)"
    exit "$FAILED"
fi

window_list() { xwininfo -root -children 2>/dev/null; }

# Windows drawn inside the Wine desktop are children of the desktop's X window,
# not top-level X windows. Enumerating the root only shows the desktop itself,
# so anything that looks for an app has to look one level down.
# Matched case-insensitively on purpose: Wine titles this window
# "shell - Wine Desktop" in Debian's build and "shell - Wine desktop" in
# Ubuntu's. Matching one spelling passes on one distribution and fails on the
# other, which is how CI found this.
desktop_id() { window_list | grep -i 'wine desktop' | awk '{print $1}' | head -1; }
desktop_children() {
    id=$(desktop_id)
    [ -n "$id" ] && xwininfo -id "$id" -children 2>/dev/null
}

waited=0
while ! window_list | grep -qi 'wine desktop'; do
    [ "$waited" -ge "$TIMEOUT" ] && break
    sleep 2
    waited=$((waited + 2))
done
if window_list | grep -qi 'wine desktop'; then
    DESKTOP_LINE=$(window_list | grep -i 'wine desktop' | sed 's/^ *//' | head -1)
    pass "desktop window exists: $DESKTOP_LINE"
else
    fail "no Wine desktop window on $DISPLAY"
    info "window list was:"; window_list | sed 's/^/      /' | head -20
    echo; echo "RESULT: FAIL"
    exit 1
fi

# --- 3. the desktop has a taskbar -----------------------------------------
# The brief's Phase 0 target is a taskbar with a running app in it, so the gate
# checks for one rather than taking the desktop window as proof.
#
# Wine's taskbar is an unnamed child of the desktop spanning its full width, a
# few tens of pixels tall, sitting at the bottom. Identify it by that shape:
# there is no window name or class to match on.
DESKTOP_W=$(echo "$DESKTOP_LINE" | sed -n 's/.*  \([0-9]\+\)x[0-9]\+[+-].*/\1/p')
#
# Kept to POSIX awk deliberately: gawk's three-argument match() is not in mawk,
# which is what a Debian image actually ships.
taskbar_line() {
    desktop_children | awk -v w="$DESKTOP_W" '
        NF >= 2 {
            geom = $(NF - 1)                    # e.g. 1280x20+0+700
            if (split(geom, a, "x") != 2) next
            if (split(a[2], b, "+") != 3) next
            width = a[1]; height = b[1]; x = b[2]
            if (width == w && height <= 64 && x == 0) { print; exit }
        }'
}
waited=0
while [ -z "$(taskbar_line)" ]; do
    [ "$waited" -ge "$TIMEOUT" ] && break
    sleep 2
    waited=$((waited + 2))
done
if [ -n "$(taskbar_line)" ]; then
    pass "taskbar present: $(taskbar_line | sed 's/^ *//')"
else
    fail "no taskbar found among the desktop's children"
    info "desktop children were:"; desktop_children | sed 's/^/      /' | head -20
fi

# --- 4. a Win32 app launches and shows up in the desktop ------------------
# notepad is the canary: a stock Win32 app with a titled top-level window.
# It must appear as a child of the desktop, not as its own X toplevel -- an app
# outside the desktop is an app that is not in the taskbar, and under a
# fullscreen compositor it covers the shell entirely.
info "launching notepad.exe"
wine notepad >"$SG_LOG_DIR/notepad.out" 2>&1 &
NOTEPAD_SHELL_PID=$!

waited=0
while ! desktop_children | grep -q 'Notepad'; do
    [ "$waited" -ge "$TIMEOUT" ] && break
    sleep 2
    waited=$((waited + 2))
done
if desktop_children | grep -q 'Notepad'; then
    pass "notepad is inside the desktop: $(desktop_children | grep 'Notepad' | sed 's/^ *//' | head -1)"
else
    fail "notepad did not appear inside the desktop after ${TIMEOUT}s"
    if window_list | grep -q 'Notepad'; then
        fail "  (it opened as its own X toplevel -- the virtual desktop is not the prefix default)"
    fi
    info "notepad output:"; sed 's/^/      /' "$SG_LOG_DIR/notepad.out" 2>/dev/null | head -20
    info "desktop children were:"; desktop_children | sed 's/^/      /' | head -20
fi

if pgrep -f 'notepad.exe' >/dev/null 2>&1; then
    pass "notepad.exe process is alive"
else
    fail "notepad.exe process is not running"
fi

# Leave the session as we found it, so the gate can be run twice.
pkill -f 'notepad.exe' >/dev/null 2>&1 || true
kill "$NOTEPAD_SHELL_PID" >/dev/null 2>&1 || true

echo
if [ "$FAILED" -eq 0 ]; then
    echo "RESULT: PASS"
else
    echo "RESULT: FAIL"
fi
exit "$FAILED"
