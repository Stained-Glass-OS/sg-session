#!/bin/sh
# Initialize the system-wide Wine prefix.
#
# Idempotent by design: the image build runs it once to bake a prefix into the
# image, and first boot runs it again in case the image build could not. The
# stamp file is what makes the second run cheap.
set -eu

SG_LIB="${SG_LIB:-/usr/lib/stained-glass}"
# shellcheck source=lib/sg-common.sh
. "$SG_LIB/sg-common.sh"
sg_wine_env

STAMP="$SG_PREFIX/.sg-initialized"

if [ -e "$STAMP" ]; then
    sg_log "prefix already initialized at $SG_PREFIX"
    exit 0
fi

sg_log "initializing system prefix at $SG_PREFIX (arch=$WINEARCH)"
mkdir -p "$SG_PREFIX" "$SG_STATE" "$SG_LOG_DIR"

# The group must be able to write the prefix, or no second user can use it --
# wine-sg requires R_OK|W_OK|X_OK on it. mkdir applies the umask, which under
# systemd leaves it group-read-only, so set the mode explicitly rather than
# leaving it to a later conditional.
if [ "${SG_SYSTEM_PREFIX:-1}" = "1" ]; then
    chmod 2770 "$SG_PREFIX" "$SG_STATE" 2>/dev/null || true
fi

# Mark the prefix as shared between Unix users before wineboot runs, so the
# server comes up in that mode from the start rather than being converted
# afterwards. On a Wine without wine-sg's patches the marker is inert.
if [ "${SG_SYSTEM_PREFIX:-1}" = "1" ]; then
    : > "$SG_PREFIX/.sg-system-prefix"
    sg_log "marked as a system prefix (shared between users)"
fi

# wineboot --init builds the prefix. It forks a wineserver that lingers for a
# few seconds after; wineserver -w waits for it so the build step cannot race
# against a half-written registry.
wineboot --init
wineserver -w

# --- make userdef.reg a real Default User profile -------------------------
# wineboot applies wine.inf's HKCU sections to whoever ran it, then stamps
# .update-timestamp in the *prefix*. The prefix is shared and the hives are
# not, so every later user's wineboot sees an up-to-date prefix and skips the
# per-user install entirely -- they are not seeded badly, they are skipped by
# design.
#
# Windows solves this with a Default User profile that the installer populates
# once. Wine has the same slot, \Registry\User\.Default, stored as
# userdef.reg, but nothing ever fills it beyond a stub. wine-sg patch 0006
# seeds each new user's hive from it, so making it a real template fixes every
# future user at the source instead of repairing each copy.
#
# The hive files are the same format -- all of them are server saves of a user
# branch -- so the template is simply this user's freshly initialised hive,
# taken now, before anyone has personalised anything. Volatile keys are never
# written to disk, so nothing user-specific comes along.
if [ "${SG_SYSTEM_PREFIX:-1}" = "1" ]; then
    _uid=$(id -u)
    _hive="$SG_PREFIX/user-$_uid.reg"
    [ -f "$_hive" ] || _hive="$SG_PREFIX/user.reg"
    if [ -f "$_hive" ] && [ -s "$_hive" ]; then
        cp -f "$_hive" "$SG_PREFIX/userdef.reg"
        sg_log "default user profile seeded from $(basename "$_hive") ($(wc -c < "$_hive") bytes)"
    else
        sg_log "WARNING: no hive to seed the default user profile from"
    fi
fi

# --- protect the policy branch -------------------------------------------
# Creating HKLM\Software\Policies here, as the prefix's owner, is what makes it
# administrator-owned. wine-sg gives a new key a descriptor from the creating
# process's token, so a key made by an administrator gets the HKLM arrangement
# — administrators write, everyone else reads — and a later attempt by an
# ordinary user to write beneath it is refused.
#
# This is deliberately policy rather than Wine behaviour: which branches a
# machine protects is the operating system's business, the same way Windows
# ships those ACLs in its image rather than inventing them in the kernel.
if [ "${SG_SYSTEM_PREFIX:-1}" = "1" ]; then
    sg_log "creating protected policy branches"
    for key in \
        'HKLM\Software\Policies' \
        'HKLM\Software\Microsoft\Windows\CurrentVersion\Policies'
    do
        wine reg add "$key" /f >/dev/null 2>&1 || sg_log "WARNING: could not create $key"
    done

    # Pre-create the display-config containers as the prefix owner (an
    # administrator). wine-sg gives keys under Control\Video and
    # Control\GraphicsDrivers a DACL that interactive users can write -- these
    # hold per-session display state every user's Wine populates and every app
    # reads -- but only if the *container* exists for them to create under, and
    # a non-admin cannot create it beneath the admin-owned Control key. Making
    # them here, once, is what lets a non-owner session come up with working
    # applications rather than a shell no app can launch into.
    sg_log "creating writable display-config branches"
    for key in \
        'HKLM\System\CurrentControlSet\Control\Video' \
        'HKLM\System\CurrentControlSet\Control\GraphicsDrivers'
    do
        wine reg add "$key" /f >/dev/null 2>&1 || sg_log "WARNING: could not create $key"
    done
    wineserver -w
fi

# Direct3D translation layers, if the image staged them. Deliberately before
# the ownership fixup below, so the DLLs it copies in are chowned with the rest
# of the prefix rather than staying root-owned inside a prefix nobody else owns.
if command -v sg-install-d3d >/dev/null 2>&1; then
    sg-install-d3d || sg_log "WARNING: D3D install failed; continuing without it"
elif [ -x "${SG_BIN:-/usr/bin}/sg-install-d3d" ]; then
    "${SG_BIN:-/usr/bin}/sg-install-d3d" || sg_log "WARNING: D3D install failed; continuing without it"
fi

# The prefix is machine state, not user state.
# MULTIUSER-DEBT: D1 — reduced but not retired. With wine-sg's shared prefix the
# hives are separated per user and HKLM is administrator-writable, but the
# prefix is still owned by one Unix user who is implicitly its administrator.
if getent passwd "$SG_USER" >/dev/null 2>&1 || getent passwd "$SG_SYSTEM_USER" >/dev/null 2>&1; then
    # Group-owned so other users can be admitted by adding them to
    # SG_WINE_GROUP; setgid so anything created inside keeps that group.
    # Owned by the SYSTEM account rather than the session user: wine-sg reads
    # the prefix's owner as the machine's administrator, and the interactive
    # user should not be one.
    _owner="$SG_USER"
    getent passwd "$SG_SYSTEM_USER" >/dev/null 2>&1 && _owner="$SG_SYSTEM_USER"
    if getent group "$SG_WINE_GROUP" >/dev/null 2>&1; then
        chown -R "$_owner:$SG_WINE_GROUP" "$SG_ROOT" "$SG_LOG_DIR" 2>/dev/null || true
        chmod 2770 "$SG_ROOT" "$SG_PREFIX"
    else
        chown -R "$_owner" "$SG_ROOT" "$SG_LOG_DIR" 2>/dev/null || true
    fi
fi

: > "$STAMP"
sg_log "prefix initialized"
