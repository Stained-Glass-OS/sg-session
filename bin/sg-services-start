#!/bin/sh
# Start the Windows service control manager in the machine-level wineserver.
#
# Runs after sg-wineserver, as root, so services.exe and everything it starts
# carry the SYSTEM SID. Clients reach it over RPC inside the server's object
# namespace, which is shared by every process attached to that server -- so one
# SCM serves every logged-in user, as on Windows.
set -eu

SG_LIB="${SG_LIB:-/usr/lib/stained-glass}"
# shellcheck source=lib/sg-common.sh
. "$SG_LIB/sg-common.sh"
# The machine's Windows system never uses a display. Whatever screen this was
# started from -- a build host's, a developer's desktop -- would otherwise be
# recorded in the shared prefix as the machine's monitor, and every user's
# desktop would be laid out for it.
unset DISPLAY WAYLAND_DISPLAY XAUTHORITY
sg_wine_env

HOME="${HOME:-$SG_ROOT}"
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/stained-glass}"
export HOME XDG_RUNTIME_DIR

# Session 0; see the note in sg-wineserver. services.exe already puts the
# services it launches on this station -- it just never put itself there,
# because on Windows its parent does that for it.
SG_WINSTATION='__wineservice_winstation\Default'
export SG_WINSTATION

# Protect the machine registry branches on the running machine server, before
# any user logs in. See sg_protect_machine_registry.
sg_log "protecting machine registry branches"
sg_protect_machine_registry

# Machine Group Policy, applied after the branches are protected so it lands in
# administrator-owned keys.
sg_log "applying machine policy"
sg_apply_policy

# The event logs are read only by the Event Log service (SYSTEM), which answers
# everyone else through its pipe and decides who may read what -- Security
# only for administrators. At the Linux level the prefix's files are all open
# to its group (D13), so their directory is made the SYSTEM account's alone:
# a user reading the prefix through Z: must not get the Security log. Wine
# cannot make it so itself (a DACL naming SYSTEM maps to user and group bits).
sg_protect_event_logs() {
    logs="$SG_PREFIX/drive_c/windows/system32/winevt/Logs"
    [ -d "$SG_PREFIX/drive_c/windows/system32" ] || return 0
    mkdir -p "$logs" || return 0
    chmod 0700 "$logs" || :
    find "$logs" -mindepth 1 -maxdepth 1 -type f -exec chmod go-rwx {} + 2>/dev/null || :
}
sg_log "protecting the event logs"
sg_protect_event_logs

sg_log "starting services.exe as SYSTEM"

# Launched detached: services.exe is a long-running Windows process, and this
# script's job is only to get it going inside the already-running server.
wine services.exe &

# Wait for the SCM to answer rather than assuming it is up. A session that
# starts before the SCM is ready sees no services and looks broken.
# Bounded by the clock, not by counting tries: on a slow machine (or an
# emulated one) each sc query itself takes seconds, and the unit's start
# timeout must never be reached -- systemd would kill the whole server.
start=$(date +%s)
while :; do
    waited=$(( $(date +%s) - start ))
    [ "$waited" -lt "${SG_SERVICES_TIMEOUT:-60}" ] || break
    if timeout 30 wine sc query >/dev/null 2>&1; then
        sg_log "SCM is answering after ${waited}s"
        exit 0
    fi
    sleep 2
done

sg_log "WARNING: the SCM did not answer within ${SG_SERVICES_TIMEOUT:-60}s"
exit 0
