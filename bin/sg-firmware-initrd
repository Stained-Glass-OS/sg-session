#!/usr/bin/python3
# sg-firmware-initrd -- the firmware this PC's early drivers asked for, in an
# initrd of its own.
#
# The image's initrd carries every kernel module but only the firmware the
# modules name in their metadata; many drivers make the file name up as they
# run -- Intel's sound DSP (intel/sof/sof-tgl.ri), Bluetooth
# (intel/ibt-19-0-4.sfi), the graphics' power management
# (i915/tgl_dmc_ver2_12.bin) -- and the regulatory database is a link the
# initrd cannot follow. Started from the initrd, those drivers found no
# firmware and did not ask again: no sound card, no Bluetooth, the GPU never
# idling (Latitude 3520, David 2026-10-02). Firmware installed after the
# image was made (sg-drivers, an apt upgrade) was never in it at all.
#
# So, at each boot (sg-firmware-retry.service) and for each new kernel (the
# kernel-install plugin): the files the kernel failed to load this boot that
# /usr/lib/firmware has now are added to the list this PC keeps
# (/var/lib/stained-glass/firmware-initrd.list -- it only grows, as a file
# that loaded from the initrd is not asked for again), and the list is
# written as sg-firmware.initrd beside the other initrds of each installed
# boot entry, which gets an initrd line for it. The next boot's early
# drivers find their firmware.
#
# On a PC with an NVIDIA Ada card (sg-nouveau-guard --ada) and no NVIDIA
# driver, sg-firmware.initrd also carries sg-nouveau-guard and its
# modprobe.d line: nouveau starts in the initrd, where it removed the
# firmware's framebuffer and then failed for want of its GSP firmware -- a
# black screen from the boot logo on, on an installed machine as on the live
# ISO (whose initrd has the guard of its own). The image's initrd and Debian's
# (initramfs-tools, after a kernel update) both get it this way, and each new
# kernel's entry (the kernel-install plugin). With the guard there nouveau
# loads in the initrd only if the initrd has the firmware, else in the real
# root if that has it. NVIDIA's driver installed (nouveau blacklisted:
# modprobe.blacklist=nouveau in /etc/kernel/cmdline, which sg-drivers puts
# there, or "blacklist nouveau" in modprobe.d) or the card gone: the guard
# is left out again. Run again when packages change those
# (sg-session.triggers) and by sg-drivers.
#
#   sg-firmware-initrd update     (root)
#   sg-firmware-initrd list       the files kept, one per line
#
# For tests: SG_ESP (the boot partition), SG_FIRMWARE_DIR (/usr/lib/firmware),
# SG_FIRMWARE_LIST (the list), SG_KERNEL_LOG (a file read instead of this
# boot's kernel log), SG_NOUVEAU_GUARD and SG_NOUVEAU_GUARD_CONF (the guard
# and its modprobe.d file), SG_KERNEL_CMDLINE_FILE (/etc/kernel/cmdline),
# SG_MODPROBE_DIRS (colon-separated: the modprobe.d directories);
# sg-nouveau-guard's own SG_GUARD_SYSFS reaches it unchanged.
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 David Hamner and the Stained Glass OS contributors
import os
import re
import subprocess
import sys

FWDIR = os.environ.get("SG_FIRMWARE_DIR", "/usr/lib/firmware")
LIST = os.environ.get("SG_FIRMWARE_LIST", "/var/lib/stained-glass/firmware-initrd.list")
NAME = "sg-firmware.initrd"
GUARD = os.environ.get("SG_NOUVEAU_GUARD", "/usr/lib/stained-glass/sg-nouveau-guard")
GUARD_CONF = os.environ.get("SG_NOUVEAU_GUARD_CONF", "/usr/lib/modprobe.d/sg-nouveau-guard.conf")
KERNEL_CMDLINE = os.environ.get("SG_KERNEL_CMDLINE_FILE", "/etc/kernel/cmdline")
MODPROBE_DIRS = os.environ.get("SG_MODPROBE_DIRS", "/etc/modprobe.d:/usr/lib/modprobe.d:/lib/modprobe.d:/run/modprobe.d").split(":")
MAX_BYTES = 64 << 20  # a boot partition is small; firmware for one PC is a few MB
FAILED = [re.compile(r"firmware: failed to load (\S+)"),
          re.compile(r"Direct firmware load for (\S+) failed"),
          re.compile(r"Failed to load \S+ firmware (\S+\.(?:bin|ri|sfi|ucode|fw|db))")]


def say(msg):
    print("sg-firmware-initrd: " + msg, file=sys.stderr)


def kernel_log():
    path = os.environ.get("SG_KERNEL_LOG")
    if path:
        with open(path, errors="replace") as f:
            return f.read()
    for cmd in (["journalctl", "-k", "-b", "-o", "cat", "--no-pager"], ["dmesg"]):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=60).stdout
        except (OSError, subprocess.SubprocessError):
            continue
    return ""


def safe(name):
    # relative, inside the firmware directory
    return bool(name) and not name.startswith("/") and ".." not in name.split("/")


def available(name):
    return os.path.isfile(os.path.join(FWDIR, name))  # follows links


def read_list():
    try:
        with open(LIST) as f:
            return [l.strip() for l in f if safe(l.strip())]
    except OSError:
        return []


def esp():
    if os.environ.get("SG_ESP"):
        return os.environ["SG_ESP"]
    # the boot partition kernel-install writes to (sg-boot-layout: /efi or /xbootldr)
    try:
        with open("/etc/kernel/install.conf") as f:
            roots = [l.strip()[len("BOOT_ROOT="):] for l in f if l.startswith("BOOT_ROOT=")]
        if roots and os.path.isdir(os.path.join(roots[-1], "loader", "entries")):
            return roots[-1]
    except OSError:
        pass
    for opt in ("--print-boot-path", "--print-esp-path"):
        try:
            out = subprocess.run(["bootctl", opt], capture_output=True, text=True, timeout=30).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            continue
        if out:
            return out
    return ""


def newc(entries):
    # an uncompressed cpio "newc" archive: (path, mode, data) for directories
    # and regular files, then the trailer
    out = bytearray()
    ino = 1
    for path, mode, data in entries + [("TRAILER!!!", 0, b"")]:
        name = path.encode() + b"\0"
        out += b"070701" + b"".join(b"%08X" % v for v in (
            ino, mode, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
        out += name + b"\0" * ((4 - (110 + len(name)) % 4) % 4)
        out += data + b"\0" * ((4 - len(data) % 4) % 4)
        ino += 1
    return bytes(out)


def nouveau_blacklisted():
    # NVIDIA's driver: sg-drivers' command line, or the driver package's own
    # modprobe.d blacklist (Debian's nvidia-kernel-support, NVIDIA's packages)
    try:
        with open(KERNEL_CMDLINE) as f:
            if re.search(r"(^|\s)modprobe\.blacklist=(\S*,)?nouveau(,|\s|$)", f.read()):
                return True
    except OSError:
        pass
    for d in MODPROBE_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".conf"):
                continue
            try:
                with open(os.path.join(d, n), errors="replace") as f:
                    if any(l.split()[:2] == ["blacklist", "nouveau"] for l in f):
                        return True
            except OSError:
                continue
    return False


def guard_wanted():
    # an NVIDIA Ada card and no NVIDIA driver: the guard goes into the initrd
    if not (os.path.isfile(GUARD) and os.path.isfile(GUARD_CONF)):
        return False
    try:
        ada = subprocess.run(["sh", GUARD, "--ada"], timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False
    return ada and not nouveau_blacklisted()


def archive(files, guard=False):
    dirs, entries, total = set(), [], 0
    extra = []
    if guard:
        for src, dst, mode in ((GUARD_CONF, "usr/lib/modprobe.d/sg-nouveau-guard.conf", 0o100644),
                               (GUARD, "usr/lib/stained-glass/sg-nouveau-guard", 0o100755)):
            with open(src, "rb") as f:
                extra.append((dst, mode, f.read()))
    for name in files:
        with open(os.path.join(FWDIR, name), "rb") as f:  # the link's target's bytes
            data = f.read()
        if total + len(data) > MAX_BYTES:
            say(f"{name} left out: the initrd would be over {MAX_BYTES >> 20} MB")
            continue
        total += len(data)
        parts = ("usr/lib/firmware/" + name).split("/")
        for i in range(1, len(parts)):
            d = "/".join(parts[:i])
            if d not in dirs:
                dirs.add(d)
                entries.append((d, 0o040755, b""))
        entries.append(("/".join(parts), 0o100644, data))
    for dst, mode, data in extra:
        parts = dst.split("/")
        for i in range(1, len(parts)):
            d = "/".join(parts[:i])
            if d not in dirs:
                dirs.add(d)
                entries.append((d, 0o040755, b""))
        entries.append((dst, mode, data))
    return newc(entries)


def entries(boot):
    d = os.path.join(boot, "loader", "entries")
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    # a live medium's entries are read-only and not this PC's
    return [os.path.join(d, n) for n in names if n.endswith(".conf") and not n.endswith("-live.conf")]


def add_to_entry(path, boot, add=True):
    # add=False: no line is added, only an initrd the entry names already
    # is returned (to be written again: emptied)
    with open(path) as f:
        lines = f.read().splitlines()
    initrds = [l.split(None, 1)[1] for l in lines if l.startswith("initrd ") and len(l.split(None, 1)) == 2]
    if not initrds:
        return None
    rel = os.path.dirname(initrds[0]) + "/" + NAME
    if rel not in initrds and not add:
        return None
    if rel not in initrds:
        last = max(i for i, l in enumerate(lines) if l.startswith("initrd "))
        lines.insert(last + 1, "initrd " + rel)
        tmp = path + ".sg-tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(tmp, path)
    return os.path.join(boot, rel.lstrip("/"))


def update():
    kept = read_list()
    asked = []
    log = kernel_log()
    for rx in FAILED:
        asked += rx.findall(log)
    new = [n for n in dict.fromkeys(asked) if safe(n) and n not in kept and available(n)]
    files = [n for n in kept + new if available(n)]
    if new:
        os.makedirs(os.path.dirname(LIST), exist_ok=True)
        with open(LIST + ".tmp", "w") as f:
            f.write("".join(n + "\n" for n in files))
        os.replace(LIST + ".tmp", LIST)
        say("firmware the early drivers asked for: " + " ".join(new))
    guard = guard_wanted()
    boot = esp()
    if not boot or not os.path.isdir(boot):
        if files or guard:
            say("no boot partition found")
        return 0
    # nothing to carry: initrds written before (the guard, now that NVIDIA's
    # driver is here) are emptied, and no entry gets a new line
    data = archive(files, guard)
    targets = set()
    for e in entries(boot):
        try:
            t = add_to_entry(e, boot, add=bool(files or guard))
        except OSError as err:
            say(f"{e}: {err}")
            continue
        if t:
            targets.add(t)
    for t in sorted(targets):
        try:
            with open(t, "rb") as f:
                if f.read() == data:
                    continue
        except OSError:
            pass
        try:
            with open(t + ".tmp", "wb") as f:
                f.write(data)
            os.replace(t + ".tmp", t)
            say(f"wrote {t} ({len(files)} firmware files" + (", the nouveau guard)" if guard else ")"))
        except OSError as err:
            say(f"{t}: {err}")
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "update":
        return update()
    if cmd == "list":
        print("\n".join(read_list()))
        return 0
    say("usage: sg-firmware-initrd update | list")
    return 2


if __name__ == "__main__":
    sys.exit(main())
