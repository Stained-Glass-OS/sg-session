#!/bin/sh
# sg-clamd-conf -- the configuration clamd starts with: Debian's
# /etc/clamav/clamd.conf (debconf's and the administrator's, untouched) with
# ConcurrentDatabaseReload no.
#
# SG Defender's memory (issue #10, 2026-11-25). clamd keeps its definitions
# loaded, about 1 GB; when freshclam brings new ones (several times a day) it
# loaded the new set beside the old by default, and peaked at twice that
# (measured: 1.92 GB, against 0.98 GB with this). Without the concurrent
# reload, scans wait while it reloads (about 10 s); a program that SG
# Defender already knows starts without asking clamd (sg-defender's cache,
# and a program clean under the day's earlier definitions starts at once and
# is scanned again in the background), so only a program never seen before
# waits, well inside wine-sg's 30 s.
#
# Written where clamd's AppArmor profile lets it read (/var/lib/clamav,
# which it loads only definitions from: *.cvd, *.cld, *.ndb, ...), and
# started with --config-file by systemd/clamav-daemon.service.d/60-sg-memory.conf.
#   SG_CLAMD_CONF_SRC  SG_CLAMD_CONF_DST   for the test
# SPDX-License-Identifier: AGPL-3.0-or-later
set -u
SRC=${SG_CLAMD_CONF_SRC:-/etc/clamav/clamd.conf}
DST=${SG_CLAMD_CONF_DST:-/var/lib/clamav/sg-clamd.conf}
tmp="$DST.sg-new.$$"
umask 022
{
    echo "# Generated by sg-clamd-conf from $SRC at each start of clamd: change that file, not this one."
    [ -r "$SRC" ] && grep -iv '^[[:space:]]*ConcurrentDatabaseReload[[:space:]]' "$SRC"
    echo "ConcurrentDatabaseReload no"
} > "$tmp" || { rm -f "$tmp"; exit 1; }
if ! mv -f "$tmp" "$DST"; then
    rm -f "$tmp"
    exit 1
fi
exit 0
