# Site overrides for the Stained Glass session.
# Sourced by nothing directly; these are the knobs sg-common.sh honours from the
# environment. Set them in a systemd drop-in or greetd's environment.

# SG_DISPLAY_PATH=x11        # x11 | wayland   (see ADR 0003)
# SG_DESKTOP_W=1280
# SG_DESKTOP_H=800
# SG_PREFIX=/var/lib/stained-glass/prefix
# WINEDEBUG=-all
