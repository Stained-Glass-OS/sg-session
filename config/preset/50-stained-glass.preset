# Remote Desktop is off until an administrator turns it on, as on Windows:
# `systemctl enable --now sg-rdpd`. A preset, because an image build applies
# presets after the package's own scripts, and Debian's default enables all.
disable sg-rdpd.service
enable sg-netmountd.socket
enable sg-netd.socket
# The administrative tools' system information: the socket everywhere.
enable sg-sysinfod.socket
# Runs on live boots only (ConditionKernelCommandLine).
enable sg-live.service
# Each user's Linux home is their Windows profile (a link), set at boot.
enable sg-shared-home.service
# Runs only while Setup's third-party drivers request is pending.
enable sg-drivers.service
# A Surface's touch and pen support: runs on Surface PCs only (ConditionFirmware).
enable sg-hwsupport.service
# Voice typing's model installer: the socket everywhere, a service per request.
enable sg-speechd.socket
# The first-run setup's service: its socket exists only while it is pending
# (ConditionPathExists), and the browser it may ask for is installed at boot
# only while that request is there.
enable sg-oobed.socket
enable sg-oobe-browser.service
# Device Manager's disabled devices stay disabled across reboots (runs only
# when there are any: ConditionPathExists).
enable sg-devices-apply.service
# The Print to PDF printer (runs only with cups-pdf installed).
enable sg-print-setup.service
# Windows' printers follow CUPS's (a printer plugged in during a session).
enable sg-printers-refresh.path
# Machine Group Policy on a domain member, at boot and every 90 minutes (both
# do nothing on a machine without a role).
enable sg-gpupdate.service
enable sg-gpupdate.timer
