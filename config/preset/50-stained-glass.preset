# Remote Desktop is off until an administrator turns it on, as on Windows:
# `systemctl enable --now sg-rdpd`. A preset, because an image build applies
# presets after the package's own scripts, and Debian's default enables all.
disable sg-rdpd.service
enable sg-netmountd.socket
enable sg-netd.socket
# Runs on live boots only (ConditionKernelCommandLine).
enable sg-live.service
# Runs only while Setup's third-party drivers request is pending.
enable sg-drivers.service
