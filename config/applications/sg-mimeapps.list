# Stained Glass OS: Windows programs, installers and shortcuts opened from a
# Linux program (Firefox's downloads) run in the session's Wine
# (sg-open-windows-file). A person's own choice (~/.config/mimeapps.list)
# still comes first.
[Default Applications]
application/x-ms-dos-executable=sg-windows-file.desktop
application/x-msdownload=sg-windows-file.desktop
application/vnd.microsoft.portable-executable=sg-windows-file.desktop
application/x-msi=sg-windows-file.desktop
application/x-ms-shortcut=sg-windows-file.desktop
