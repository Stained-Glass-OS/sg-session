#!/bin/sh
set -e

SG_ROOT=/var/lib/stained-glass
SG_USER=sguser
SG_SYSTEM_USER=sgsystem
SG_WINE_GROUP=sgwine
SG_ADMIN_GROUP=sg-admins

case "$1" in
    configure)
        # every account may ping (60-stained-glass-ping.conf) -- now, not
        # only from the next boot
        sysctl -q -p /usr/lib/sysctl.d/60-stained-glass-ping.conf >/dev/null 2>&1 || true
        # Debian's sysctl defaults (linux-sysctl-defaults): vm.max_map_count
        # for programs that map hundreds of DLLs -- now, not at the next boot
        sysctl -q -p /usr/lib/sysctl.d/50-default.conf >/dev/null 2>&1 || true

        # Machines installed from images before 2026-09-30 kept the image
        # build's own trixie.sources beside debian.sources: apt warned
        # "Target Packages ... is configured multiple times" on every update
        # (David). Only that leftover is removed -- the build's file names
        # the -debug archive, which no source we write does.
        _src=/etc/apt/sources.list.d
        if [ -f "$_src/trixie.sources" ] && [ -f "$_src/debian.sources" ] \
           && grep -q 'deb.debian.org/debian-debug' "$_src/trixie.sources"; then
            rm -f "$_src/trixie.sources" || true
        fi

        # The splash's own initrd was named sg-splash.initrd, and Plymouth,
        # finding "splash" first inside that name on the command line,
        # decided the boot had no splash and showed text. Rename it in the
        # boot entries of machines installed with that name.
        # (never fatal: a live system's boot medium is read-only)
        if command -v bootctl >/dev/null 2>&1 && _esp=$(bootctl --print-boot-path 2>/dev/null) \
           && [ -d "$_esp/loader/entries" ]; then (
            for _e in "$_esp"/loader/entries/*.conf; do
                [ -f "$_e" ] && grep -q '^initrd /.*/sg-splash\.initrd$' "$_e" || continue
                for _i in $(sed -n 's|^initrd \(/.*\)/sg-splash\.initrd$|\1|p' "$_e"); do
                    [ -f "$_esp$_i/sg-splash.initrd" ] && mv -f "$_esp$_i/sg-splash.initrd" "$_esp$_i/sg-theme.initrd"
                done
                sed -i 's|^\(initrd /.*\)/sg-splash\.initrd$|\1/sg-theme.initrd|' "$_e"
            done
        ) || true
        fi
        # SSH on, with passwords for people's accounts (David 2026-10-01):
        # the image's lab-only leftovers go, and the server is enabled once,
        # when this version first arrives (an administrator may turn it off).
        if [ -r /usr/lib/stained-glass/sg-common.sh ]; then (
            . /usr/lib/stained-glass/sg-common.sh >/dev/null 2>&1 && sg_ssh_migrate /
        ) || true
        fi
        if [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.1.0-86; then
            if [ -d /run/systemd/system ]; then
                systemctl daemon-reload >/dev/null 2>&1 || true
                systemctl enable --now ssh.service >/dev/null 2>&1 || true
            else
                systemctl enable ssh.service >/dev/null 2>&1 || true
            fi
        fi

        # Stained Glass Firewall (0.1.0-175), on by default. A machine in use
        # gets it without losing what it serves: the networks it knows are
        # Private, and what listens now (a service, a program) keeps a rule --
        # logged in /var/lib/stained-glass/firewall/upgrade.log. The service
        # itself is started below (debhelper), after this.
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.1.0-175; then
            /usr/bin/sg-firewall migrate >/dev/null 2>&1 || true
        fi

        # The session user owns the system prefix. Phase 0 has exactly one.
        # MULTIUSER-DEBT: D1, D2 -- see docs/multiuser-debt.md.
        #
        # --no-create-home is deliberate. adduser would chown the home
        # directory, and that fails with EINVAL inside an unprivileged user
        # namespace, which is exactly where image builders like mkosi run.
        # The directories are created and owned by tmpfiles.d instead, at boot,
        # where the uid actually exists and the chown is legal.
        # Membership of this group is what admits a Unix user to the shared
        # system prefix: wine-sg decides who may connect to the wineserver by
        # the group owning its directory, which it takes from the prefix. So
        # adding someone here is how you give them a Windows session.
        if ! getent group "$SG_WINE_GROUP" >/dev/null; then
            addgroup --system "$SG_WINE_GROUP"
        fi

        # Administrators (ADR 0012): members may elevate to the SYSTEM account
        # and use sudo. A single group is the whole definition of "admin".
        if ! getent group "$SG_ADMIN_GROUP" >/dev/null; then
            addgroup --system "$SG_ADMIN_GROUP"
        fi
        # Grant that group sudo, without weakening PAM: the sudoers drop-in
        # names the group, and sudo still authenticates the human normally
        # (that is how "sudo su" reaches root as themselves -- ADR 0012 D).
        if [ -d /etc/sudoers.d ]; then
            printf '%%%s ALL=(ALL:ALL) ALL\n' "$SG_ADMIN_GROUP" > /etc/sudoers.d/sg-admins
            chmod 0440 /etc/sudoers.d/sg-admins
        fi

        # The account that is SYSTEM: owns the prefix, runs the machine-level
        # wineserver. Unprivileged on the Unix side -- see sg-common.sh.
        if ! getent passwd "$SG_SYSTEM_USER" >/dev/null; then
            adduser --system --group --no-create-home --home "$SG_ROOT" \
                    --gecos "Stained Glass SYSTEM account" \
                    --disabled-password "$SG_SYSTEM_USER"
        fi
        adduser "$SG_SYSTEM_USER" "$SG_WINE_GROUP" >/dev/null 2>&1 || true

        # Device access for driver work -- printers, scanners, USB and serial
        # devices. This is what an installed Windows driver actually needs from
        # the Unix side; the NT privilege to install it is a separate thing,
        # decided by wine-sg from who owns the prefix.
        for grp in lp lpadmin scanner plugdev dialout video render input; do
            getent group "$grp" >/dev/null && \
                adduser "$SG_SYSTEM_USER" "$grp" >/dev/null 2>&1 || true
        done
        # ...and a device plugged in already takes the rules now, not at
        # its next plugging in (an Ambir scanner on the desk, 1dcc)
        if [ -d /run/udev ]; then
            udevadm control --reload >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=usb --attr-match=idVendor=1dcc >/dev/null 2>&1 || true
            # a DYMO LabelWriter plugged in already gets its queue now
            udevadm trigger --action=add --subsystem-match=usb --attr-match=idVendor=0922 >/dev/null 2>&1 || true
        fi

        if ! getent passwd "$SG_USER" >/dev/null; then
            adduser --system --group --no-create-home --home "$SG_ROOT" \
                    --gecos "Stained Glass session user" \
                    --disabled-password "$SG_USER"
        fi
        adduser "$SG_USER" "$SG_WINE_GROUP" >/dev/null 2>&1 || true

        # NOT video or input. Membership of `input` lets any program the user
        # runs read /dev/input/event* -- raw keystrokes straight from the
        # kernel, including the password typed at the lock screen, going round
        # the compositor and defeating ADR 0009 entirely. The compositor does
        # not need it: under logind (greetd's PAM session) it is handed its
        # devices for the active session only. Existing installs are corrected
        # too, since the first packages did add the user to both. `render`
        # stays: GPU render nodes carry no input.
        for grp in video input; do
            getent group "$grp" >/dev/null && deluser "$SG_USER" "$grp" >/dev/null 2>&1 || true
        done
        getent group render >/dev/null && adduser "$SG_USER" render >/dev/null 2>&1 || true

        # The login screen's account. It runs the Windows-style greeter in the
        # shared prefix (with its own hive) and nothing else; no password, no
        # device groups, no home.
        if ! getent passwd sggreet >/dev/null; then
            adduser --system --group --no-create-home --home "$SG_ROOT" \
                    --gecos "Stained Glass login screen" \
                    --disabled-password sggreet
        fi
        adduser sggreet "$SG_WINE_GROUP" >/dev/null 2>&1 || true
        # Setup's installer service answers this group (its socket exists
        # only on a live boot): the login screen, where Setup runs full
        # screen, and the live session's account, made at boot.
        getent group sgsetup >/dev/null || addgroup --system sgsetup >/dev/null
        adduser sggreet sgsetup >/dev/null 2>&1 || true
        getent group render >/dev/null && adduser sggreet render >/dev/null 2>&1 || true

        # Remote Desktop's network-facing side runs as this account and nothing
        # more (sg-rdp-authd drops to it after forking its root monitor).
        # It needs a home: FreeRDP will not make a connection's settings
        # without one ("KNOWN_PATH_HOME is (nil)", and every connection fails).
        if ! getent passwd sgrdp >/dev/null; then
            adduser --system --group --no-create-home --home /var/lib/sg-rdp \
                    --gecos "Stained Glass Remote Desktop" \
                    --disabled-password sgrdp
        fi
        # Its home is made by tmpfiles.d (sg-session.conf): an image build
        # cannot chown here.

        # The Windows profile service: pam_exec runs sg-profile-create as each
        # session opens (/usr/share/pam-configs/stained-glass-profile); and
        # sg-audit, the Security log's sign-in/sign-out events
        # (stained-glass-audit); sg-keyring-first, the keyring made at a
        # person's first sign-in (stained-glass-keyring).
        pam-auth-update --package

        # The quiet boot (the splash, no Linux text) and its recovery-mode
        # entries, on machines installed before they came (sg-boot-splash).
        # Later kernels (Debian's updates) get boot entries, with boot
        # counting; one installed since without an entry gets it now.
        /usr/bin/sg-kernel-entries --apply || true
        /usr/bin/sg-boot-splash apply || true

        # Print to PDF's PDFs in the Windows profiles' Documents: the
        # cups-pdf profile takes our local include (AppArmor enforcing, as
        # it is once a kernel update has brought it)
        if command -v apparmor_parser >/dev/null 2>&1 && [ -f /etc/apparmor.d/usr.sbin.cupsd ] \
           && grep -qs '^/usr/lib/cups/backend/cups-pdf ' /sys/kernel/security/apparmor/profiles; then
            apparmor_parser -r -T -W /etc/apparmor.d/usr.sbin.cupsd >/dev/null 2>&1 || true
        fi
        ;;
    triggered)
        ;;
esac

# The units as this package has them, before debhelper restarts sg-prefix-init
# below: with the old sg-wineserver unit still loaded (Requires=), that
# restart stopped the machine's wineserver
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
fi

# The machine's wineserver after an update (configure) or a wine-sg update
# (the trigger on its wineserver): restarted only when the installed Wine
# can no longer talk to it -- otherwise every Windows program in every
# session would end for nothing
if [ "$1" = configure ] || [ "$1" = triggered ]; then
    if [ -r /usr/lib/stained-glass/sg-common.sh ]; then
        # shellcheck source=lib/sg-common.sh
        . /usr/lib/stained-glass/sg-common.sh
        if sg_wineserver_stale; then
            echo "sg-session: the Windows system's server is restarted for the new Wine"
            systemctl restart sg-wineserver.service || true
        fi
    fi
fi

#DEBHELPER#
exit 0
