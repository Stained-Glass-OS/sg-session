#!/bin/sh
set -e

SG_ROOT=/var/lib/stained-glass
SG_USER=sguser
SG_SYSTEM_USER=sgsystem
SG_WINE_GROUP=sgwine
SG_ADMIN_GROUP=sg-admins

case "$1" in
    configure)
        # The session user owns the system prefix. Phase 0 has exactly one.
        # MULTIUSER-DEBT: D1, D2 -- see docs/multiuser-debt.md.
        #
        # --no-create-home is deliberate. adduser would chown the home
        # directory, and that fails with EINVAL inside an unprivileged user
        # namespace, which is exactly where image builders like mkosi run.
        # The directories are created and owned by tmpfiles.d instead, at boot,
        # where the uid actually exists and the chown is legal.
        # Membership of this group is what admits a Unix user to the shared
        # system prefix: wine-sg decides who may connect to the wineserver by
        # the group owning its directory, which it takes from the prefix. So
        # adding someone here is how you give them a Windows session.
        if ! getent group "$SG_WINE_GROUP" >/dev/null; then
            addgroup --system "$SG_WINE_GROUP"
        fi

        # Administrators (ADR 0012): members may elevate to the SYSTEM account
        # and use sudo. A single group is the whole definition of "admin".
        if ! getent group "$SG_ADMIN_GROUP" >/dev/null; then
            addgroup --system "$SG_ADMIN_GROUP"
        fi
        # Grant that group sudo, without weakening PAM: the sudoers drop-in
        # names the group, and sudo still authenticates the human normally
        # (that is how "sudo su" reaches root as themselves -- ADR 0012 D).
        if [ -d /etc/sudoers.d ]; then
            printf '%%%s ALL=(ALL:ALL) ALL\n' "$SG_ADMIN_GROUP" > /etc/sudoers.d/sg-admins
            chmod 0440 /etc/sudoers.d/sg-admins
        fi

        # The account that is SYSTEM: owns the prefix, runs the machine-level
        # wineserver. Unprivileged on the Unix side -- see sg-common.sh.
        if ! getent passwd "$SG_SYSTEM_USER" >/dev/null; then
            adduser --system --group --no-create-home --home "$SG_ROOT" \
                    --gecos "Stained Glass SYSTEM account" \
                    --disabled-password "$SG_SYSTEM_USER"
        fi
        adduser "$SG_SYSTEM_USER" "$SG_WINE_GROUP" >/dev/null 2>&1 || true

        # Device access for driver work -- printers, scanners, USB and serial
        # devices. This is what an installed Windows driver actually needs from
        # the Unix side; the NT privilege to install it is a separate thing,
        # decided by wine-sg from who owns the prefix.
        for grp in lp lpadmin scanner plugdev dialout video render input; do
            getent group "$grp" >/dev/null && \
                adduser "$SG_SYSTEM_USER" "$grp" >/dev/null 2>&1 || true
        done

        if ! getent passwd "$SG_USER" >/dev/null; then
            adduser --system --group --no-create-home --home "$SG_ROOT" \
                    --gecos "Stained Glass session user" \
                    --disabled-password "$SG_USER"
        fi
        adduser "$SG_USER" "$SG_WINE_GROUP" >/dev/null 2>&1 || true

        # NOT video or input. Membership of `input` lets any program the user
        # runs read /dev/input/event* -- raw keystrokes straight from the
        # kernel, including the password typed at the lock screen, going round
        # the compositor and defeating ADR 0009 entirely. The compositor does
        # not need it: under logind (greetd's PAM session) it is handed its
        # devices for the active session only. Existing installs are corrected
        # too, since the first packages did add the user to both. `render`
        # stays: GPU render nodes carry no input.
        for grp in video input; do
            getent group "$grp" >/dev/null && deluser "$SG_USER" "$grp" >/dev/null 2>&1 || true
        done
        getent group render >/dev/null && adduser "$SG_USER" render >/dev/null 2>&1 || true

        # The login screen's account. It runs the Windows-style greeter in the
        # shared prefix (with its own hive) and nothing else; no password, no
        # device groups, no home.
        if ! getent passwd sggreet >/dev/null; then
            adduser --system --group --no-create-home --home "$SG_ROOT" \
                    --gecos "Stained Glass login screen" \
                    --disabled-password sggreet
        fi
        adduser sggreet "$SG_WINE_GROUP" >/dev/null 2>&1 || true
        getent group render >/dev/null && adduser sggreet render >/dev/null 2>&1 || true

        # The Windows profile service: pam_exec runs sg-profile-create as each
        # session opens (/usr/share/pam-configs/stained-glass-profile).
        pam-auth-update --package
        ;;
esac

#DEBHELPER#
exit 0
