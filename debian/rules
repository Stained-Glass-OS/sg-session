#!/usr/bin/make -f

%:
	dh $@

# The full gate stands up a compositor and a Wine prefix. That belongs in CI
# and on a developer box, not inside a package build, which may have neither a
# seat nor a writable HOME. Package builds lint only.
override_dh_auto_test:
	$(MAKE) lint

override_dh_auto_build:

override_dh_installsystemd:
	dh_installsystemd --name=sg-brokerd
	dh_installsystemd --name=sg-prefix-init
	dh_installsystemd --no-start --name=sg-shared-home
	# not restarted by an update (that ends every Windows program): the
	# postinst restarts it only when the installed Wine cannot talk to it
	dh_installsystemd --no-restart-after-upgrade --no-stop-on-upgrade --name=sg-wineserver
	dh_installsystemd --name=sg-lockd
	dh_installsystemd --name=sg-defender
	# Setup's installer: the socket is enabled everywhere and exists only on
	# a live boot (ConditionKernelCommandLine); the service is per connection.
	dh_installsystemd sg-installd.socket
	# Network settings: the socket everywhere, the service per request.
	dh_installsystemd sg-netd.socket
	# The administrative tools' system information: likewise.
	dh_installsystemd sg-sysinfod.socket
	# Voice typing's model installer: likewise.
	dh_installsystemd sg-speechd.socket
	# The live session's account and shortcuts: enabled, runs on live boots only.
	dh_installsystemd --no-start sg-live.service
	# Third-party drivers at the first boot: runs only while Setup's request
	# is pending (ConditionPathExists); never started by the package.
	dh_installsystemd --no-start sg-drivers.service
	# A Surface's own hardware support: enabled everywhere, runs on Surface
	# PCs only (ConditionFirmware), never started by the package (apt inside
	# dpkg): at the next boot.
	dh_installsystemd --no-start sg-hwsupport.service
	# Debian's kernels off the FAT boot partition: once, at the next boot
	# (not under dpkg, while a kernel package may be unpacking into /boot).
	dh_installsystemd --no-start sg-boot-layout.service
	# Remote Desktop is off by default, as on Windows.
	dh_installsystemd --no-enable --no-start sg-rdpd.service
	# The timer is enabled and started. The service it runs is installed but
	# never started by the package: a postinst that started it would run an
	# update check -- network, downloads -- inside dpkg on a live system.
	dh_installsystemd sg-update-prepare.timer
	dh_installsystemd --no-start sg-update-prepare.service
	# Machine Group Policy on a domain member: at boot (the service, never
	# started by the package) and every 90 minutes (the timer). Both do
	# nothing unless the machine has a role (ConditionPathExists).
	dh_installsystemd sg-gpupdate.timer
	dh_installsystemd --no-start sg-gpupdate.service
	# The sound firmware the initrd could not load: enabled on install and
	# upgrade, runs at the next boot (rebinding a sound card under a running
	# session is not the package's business).
	dh_installsystemd --no-start sg-firmware-retry.service
	# The early drivers' firmware for the next boot: enabled, runs at boot.
	dh_installsystemd --no-start sg-firmware-initrd.service
	# Windows' printers follow CUPS's: the path unit enabled and started.
	dh_installsystemd sg-printers-refresh.path
