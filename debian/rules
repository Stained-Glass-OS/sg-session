#!/usr/bin/make -f

%:
	dh $@

# The full gate stands up a compositor and a Wine prefix. That belongs in CI
# and on a developer box, not inside a package build, which may have neither a
# seat nor a writable HOME. Package builds lint only.
override_dh_auto_test:
	$(MAKE) lint

override_dh_auto_build:

override_dh_installsystemd:
	dh_installsystemd --name=sg-brokerd
	dh_installsystemd --name=sg-prefix-init
	dh_installsystemd --name=sg-wineserver
	dh_installsystemd --name=sg-lockd
	# Setup's installer: the socket is enabled everywhere and exists only on
	# a live boot (ConditionKernelCommandLine); the service is per connection.
	dh_installsystemd sg-installd.socket
	# Network settings: the socket everywhere, the service per request.
	dh_installsystemd sg-netd.socket
	# Voice typing's model installer: likewise.
	dh_installsystemd sg-speechd.socket
	# The live session's account and shortcuts: enabled, runs on live boots only.
	dh_installsystemd --no-start sg-live.service
	# Third-party drivers at the first boot: runs only while Setup's request
	# is pending (ConditionPathExists); never started by the package.
	dh_installsystemd --no-start sg-drivers.service
	# Remote Desktop is off by default, as on Windows.
	dh_installsystemd --no-enable --no-start sg-rdpd.service
	# The timer is enabled and started. The service it runs is installed but
	# never started by the package: a postinst that started it would run an
	# update check -- network, downloads -- inside dpkg on a live system.
	dh_installsystemd sg-update-prepare.timer
	dh_installsystemd --no-start sg-update-prepare.service
